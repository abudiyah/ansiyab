# منصة انسياب: ملف إعداد نموذجي (انسخه إلى .env ولا ترفع .env إلى المستودع)

# live = مصادر حقيقية فقط | simulation = بيانات محاكاة موسومة مع شريط دائم
MODE=live
PORT=8787
REGION=riyadh
DATA_DIR=./data/runtime

# TomTom (السرعات والحوادث). يبقى في الخادم فقط ولا يصل إلى المتصفح.
# الخطة المجانية: 20,000 طلب/شهر لبيانات المقاطع و2,500 للحوادث (docs.tomtom.com/pricing)
TOMTOM_API_KEY=
TOMTOM_FLOW_MONTHLY_QUOTA=20000
TOMTOM_INCIDENTS_MONTHLY_QUOTA=2500
TOMTOM_MONITOR_POINTS=12
# عرض بلاطات TomTom النقطية كطبقة مستقلة (200,000 طلب/شهر مجانًا)
TOMTOM_RASTER_TILES=true

# المركز الوطني للأرصاد: يُضبط بعد اعتماد طلب الوصول
NCM_EWS_BASE_URL=
NCM_EWS_AUTH_HEADER=

# HERE (موصل مؤجل)
HERE_API_KEY=

# رمز الإدارة لتعديل قواعد التنبيه وتسجيل الإجراءات (أي نص عشوائي طويل)
ADMIN_TOKEN=

# نقاط نهاية بديلة (خوادم ذاتية للتشغيل الفعلي)
# قائمة مفصولة بفواصل تُجرَّب بالترتيب (الثانية مرآة VK المدرجة في ويكي OSM)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
OSRM_BASE=https://router.project-osrm.org
# نطاق الطرق: all = كل الفئات داخل أحياء العينة + الرئيسية على مستوى المدينة
ROADS_SCOPE=sample
